# Optional: enables AI job analysis and public job discovery.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=gpt-5

# Keep disabled until you explicitly want Web Search collection.
ENABLE_WEB_DISCOVERY=false

# Optional local server port (defaults to 4174).
# PORT=4174
